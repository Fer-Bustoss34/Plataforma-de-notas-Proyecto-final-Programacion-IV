<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="650.0" prefWidth="980.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.AdminController">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="labelBienvenida"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>
            <Button text="Cerrar Sesión" onAction="#onCerrarSesion"
                    style="-fx-background-color: transparent; -fx-text-fill: #e94560;
                           -fx-border-color: #e94560; -fx-border-radius: 5;
                           -fx-background-radius: 5; -fx-padding: 5 15; -fx-cursor: hand;"/>
        </HBox>

        <TabPane style="-fx-background-color: #16213e;" tabClosingPolicy="UNAVAILABLE">

            <!-- ── TAB ESTUDIANTES ── -->
            <Tab text="Estudiantes">
                <VBox spacing="10" style="-fx-background-color: #16213e; -fx-padding: 15;">
                    <TableView fx:id="tablaEstudiantes" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colEstCedula"   text="Cédula"   prefWidth="100"/>
                            <TableColumn fx:id="colEstNombre"   text="Nombre"   prefWidth="180"/>
                            <TableColumn fx:id="colEstCorreo"   text="Correo"   prefWidth="200"/>
                            <TableColumn fx:id="colEstSemestre" text="Semestre" prefWidth="80"/>
                        </columns>
                    </TableView>

                    <Label text="Registrar nuevo estudiante"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;"/>
                    <HBox spacing="8">
                        <TextField fx:id="campoEstCedula"     promptText="Cédula"      prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoEstNombre"     promptText="Nombre"      prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoEstApellido"   promptText="Apellido"    prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoEstCorreo"     promptText="Correo"      prefWidth="140"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoEstContrasena" promptText="Contraseña"  prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoEstCodigo"     promptText="Código"      prefWidth="80"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoEstSemestre"   promptText="Semestre"    prefWidth="75"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Registrar" onAction="#onRegistrarEstudiante"
                                style="-fx-background-color:#e94560;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                        <Button text="Eliminar seleccionado" onAction="#onEliminarEstudiante"
                                style="-fx-background-color:#444;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                        <Label fx:id="labelEstMsg" text="" style="-fx-text-fill:#00ff88;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ── TAB DOCENTES ── -->
            <Tab text="Docentes">
                <VBox spacing="10" style="-fx-background-color: #16213e; -fx-padding: 15;">
                    <TableView fx:id="tablaDocentes" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colDocCedula"       text="Cédula"       prefWidth="100"/>
                            <TableColumn fx:id="colDocNombre"       text="Nombre"       prefWidth="180"/>
                            <TableColumn fx:id="colDocCorreo"       text="Correo"       prefWidth="200"/>
                            <TableColumn fx:id="colDocEspecialidad" text="Especialidad" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <Label text="Registrar nuevo docente"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;"/>
                    <HBox spacing="8">
                        <TextField fx:id="campoDocCedula"      promptText="Cédula"       prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoDocNombre"      promptText="Nombre"       prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoDocApellido"    promptText="Apellido"     prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoDocCorreo"      promptText="Correo"       prefWidth="140"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoDocContrasena"  promptText="Contraseña"   prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoDocCodigo"      promptText="Código"       prefWidth="80"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoDocEspecialidad" promptText="Especialidad" prefWidth="120"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Registrar" onAction="#onRegistrarDocente"
                                style="-fx-background-color:#e94560;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                        <Button text="Eliminar seleccionado" onAction="#onEliminarDocente"
                                style="-fx-background-color:#444;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                        <Label fx:id="labelDocMsg" text="" style="-fx-text-fill:#00ff88;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ── TAB MATERIAS ── -->
            <Tab text="Materias">
                <VBox spacing="10" style="-fx-background-color: #16213e; -fx-padding: 15;">
                    <TableView fx:id="tablaMaterias" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colMatCodigo"   text="Código"    prefWidth="100"/>
                            <TableColumn fx:id="colMatNombre"   text="Nombre"    prefWidth="200"/>
                            <TableColumn fx:id="colMatCreditos" text="Créditos"  prefWidth="80"/>
                            <TableColumn fx:id="colMatDocente"  text="Docente"   prefWidth="200"/>
                        </columns>
                    </TableView>

                    <Label text="Registrar nueva materia"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;"/>
                    <HBox spacing="10">
                        <TextField fx:id="campoMatCodigo"        promptText="Código"          prefWidth="120"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoMatNombre"        promptText="Nombre"          prefWidth="180"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoMatCreditos"      promptText="Créditos"        prefWidth="80"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoMatCedulaDocente" promptText="Cédula docente"  prefWidth="130"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Registrar materia" onAction="#onRegistrarMateria"
                                style="-fx-background-color:#e94560;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                        <Label fx:id="labelMatMsg" text="" style="-fx-text-fill:#00ff88;"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </VBox>
</AnchorPane>
