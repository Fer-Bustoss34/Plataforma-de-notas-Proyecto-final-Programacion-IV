<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="500.0" prefWidth="420.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.LoginController">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="40" bottom="40" left="50" right="50"/></padding>

        <!-- Título -->
        <Label text="Sistema de Notas"
               style="-fx-font-size: 28px; -fx-font-weight: bold;
                      -fx-text-fill: #e94560;"/>

        <Label text="Inicia sesión para continuar"
               style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>

        <Region prefHeight="10"/>

        <!-- Campo Correo -->
        <VBox spacing="6">
            <Label text="Correo electrónico"
                   style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            <TextField fx:id="campoCorreo"
                       promptText="ejemplo@correo.com"
                       style="-fx-background-color: #16213e;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #666666;
                              -fx-border-color: #e94560;
                              -fx-border-radius: 5;
                              -fx-background-radius: 5;
                              -fx-padding: 10;
                              -fx-font-size: 13px;"
                       prefWidth="320"/>
        </VBox>

        <!-- Campo Contraseña -->
        <VBox spacing="6">
            <Label text="Contraseña"
                   style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            <PasswordField fx:id="campoContrasena"
                           promptText="••••••••"
                           style="-fx-background-color: #16213e;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #666666;
                                  -fx-border-color: #e94560;
                                  -fx-border-radius: 5;
                                  -fx-background-radius: 5;
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;"
                           prefWidth="320"/>
        </VBox>

        <!-- Mensaje de error -->
        <Label fx:id="mensajeError"
               text=""
               style="-fx-text-fill: #e94560; -fx-font-size: 12px;"/>

        <!-- Botón Login -->
        <Button fx:id="botonLogin"
                text="Iniciar Sesión"
                onAction="#onLogin"
                prefWidth="320" prefHeight="42"
                style="-fx-background-color: #e94560;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;
                       -fx-cursor: hand;"/>

    </VBox>
</AnchorPane>