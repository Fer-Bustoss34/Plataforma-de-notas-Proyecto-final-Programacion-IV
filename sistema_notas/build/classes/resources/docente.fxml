<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.DocenteController">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label fx:id="labelBienvenida"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>

        <Button text="Cerrar Sesión" onAction="#onCerrarSesion"
        style="-fx-background-color: transparent; -fx-text-fill: #e94560;
               -fx-border-color: #e94560; -fx-border-radius: 5;
               -fx-background-radius: 5; -fx-padding: 5 15; -fx-cursor: hand;"/>

        <!-- Selector de materia -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Materia:" style="-fx-text-fill: #cccccc;"/>
            <ComboBox fx:id="comboMaterias" prefWidth="300" onAction="#onSeleccionarMateria"
                      style="-fx-background-color:#0f3460;-fx-text-fill:white;"/>
        </HBox>

        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color:#16213e;">

            <!-- ── TAB CALIFICACIONES ── -->
            <Tab text="Calificaciones">
                <VBox spacing="10" style="-fx-background-color:#16213e; -fx-padding:15;">

                    <TableView fx:id="tablaCalificaciones" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="colCalEstudiante" text="Estudiante"  prefWidth="180"/>
                            <TableColumn fx:id="colCalActividad"  text="Actividad"   prefWidth="150"/>
                            <TableColumn fx:id="colCalPorcentaje" text="Porcentaje"  prefWidth="100"/>
                            <TableColumn fx:id="colCalNota"       text="Nota"        prefWidth="80"/>
                        </columns>
                    </TableView>

                    <Label text="Registrar calificación"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:13px;"/>
                    <HBox spacing="10">
                        <TextField fx:id="campoCalCedulaEst" promptText="Cédula estudiante" prefWidth="160"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <ComboBox fx:id="comboActividades" promptText="Actividad" prefWidth="200"
                                  style="-fx-background-color:#0f3460;-fx-text-fill:white;"/>
                        <TextField fx:id="campoCalNota" promptText="Nota (0-5)" prefWidth="100"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <Button text="Registrar" onAction="#onRegistrarCalificacion"
                                style="-fx-background-color:#e94560;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                    </HBox>
                    <Label fx:id="labelCalMsg" text="" style="-fx-text-fill:#00ff88;"/>
                </VBox>
            </Tab>

            <!-- ── TAB ACTIVIDADES ── -->
            <Tab text="Actividades">
                <VBox spacing="10" style="-fx-background-color:#16213e; -fx-padding:15;">
                    <Label text="Agregar actividad a la materia seleccionada"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:13px;"/>
                    <HBox spacing="10">
                        <TextField fx:id="campoActNombre"     promptText="Nombre actividad"  prefWidth="200"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <TextField fx:id="campoActPorcentaje" promptText="Porcentaje (ej: 30)" prefWidth="150"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <Button text="Agregar" onAction="#onAgregarActividad"
                                style="-fx-background-color:#e94560;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                    </HBox>
                    <Label fx:id="labelActMsg" text="" style="-fx-text-fill:#00ff88;"/>
                </VBox>
            </Tab>

            <!-- ── TAB NOTA FINAL ── -->
            <Tab text="Nota Final">
                <VBox spacing="10" style="-fx-background-color:#16213e; -fx-padding:15;">
                    <Label text="Calcular nota final de un estudiante"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:13px;"/>
                    <HBox spacing="10">
                        <TextField fx:id="campoNotaFinalCedula" promptText="Cédula estudiante" prefWidth="200"
                                   style="-fx-background-color:#0f3460;-fx-text-fill:white;-fx-prompt-text-fill:#888;-fx-padding:7;"/>
                        <Button text="Calcular" onAction="#onVerNotaFinal"
                                style="-fx-background-color:#e94560;-fx-text-fill:white;-fx-padding:8 20;-fx-background-radius:5;"/>
                    </HBox>
                    <Label fx:id="labelNotaFinal" text="" style="-fx-text-fill:#00ff88; -fx-font-size:16px;"/>
                </VBox>
            </Tab>

        </TabPane>
    </VBox>
</AnchorPane>
